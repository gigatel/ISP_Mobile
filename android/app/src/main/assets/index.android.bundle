//!========= COMMON =========
app_name_long:'\u0917\u0940\u0917\u093e\u091f\u0947\u0932 \u0938\u0949\u0932\u094d\u092f\u0942\u0936\u0928',app_name_short:'\u091c\u0940\u091f\u0940\u092a\u0940\u090f\u0932',login:'\u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902',otp:'\u0913\u091f\u0940\u092a\u0940',verification:'\u0938\u0924\u094d\u092f\u093e\u092a\u0928',change:' \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928',logout:'\u0932\u0949\u0917 \u0906\u0909\u091f',mobile:'\u092e\u094b\u092c\u093e\u0907\u0932',email:'\u0908\u092e\u0947\u0932',zone:'\u091c\u094b\u0921\u093e',shift:'\u0936\u093f\u092b\u091f',current_address:'\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u0924\u093e',add_address:'\u092a\u0924\u093e \u091c\u094b\u0921\u093c\u0947\u0902',update_address:'\u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902',app_modules:'\u0910\u092a \u092e\u0949\u0921\u094d\u092f\u0942\u0932\u0947\u0902',
//!========= TITLE =========
title:{mobile_no:'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930'},
//!========= Validation =========
validation:{empty_mobile:'\u0915\u0943\u092a\u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',invalid_mobile:'\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0928\u094d\u092f \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',wait_for_otp:'\u0915\u0943\u092a\u092f\u093e \u0911\u091f\u094b\u092b\u093f\u0932 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u0915\u094b\u0921 \u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902!',invalid_otp:'\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0928\u094d\u092f \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902!',only_autofill_allowed:'\u0915\u0947\u0935\u0932 \u0911\u091f\u094b\u092b\u093f\u0932 \u0915\u094b\u0921 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0939\u0948'},
//!========= PLACEHOLDER =========
placeholder:{enter_mobile:'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902'},mobile_code_desc:'\u0939\u092e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u090f\u0915 \u092c\u093e\u0930 \u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 (OTP) \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964\u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0947 \u0928\u0940\u091a\u0947 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',otp_sent_mobile:'\u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0939\u0948 ',keep_open_numberpad:'\u0911\u091f\u094b \u092b\u093f\u0932 \u0915\u094b\u0921 \u0915\u093e \u0938\u0941\u091d\u093e\u0935 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0928\u0902\u092c\u0930-\u092a\u0948\u0921 \u0913\u092a\u0928 \u0930\u0916\u0947\u0902, \u091c\u092c \u0915\u094b\u0921 \u0915\u094b \u092d\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964',did_not_get_code:'\u0915\u094b\u0921 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e?',resend_code:' Resend \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 ',resend_after:' \u0915\u0947 \u092c\u093e\u0926 \u092d\u0947\u091c\u0947 ',waiting_for_otp:'\u0911\u091f\u094b \u092d\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u092e\u0947\u0902',are_you_sure_logout:'\u0915\u094d\u092f\u093e \u0906\u092a \u0932\u0949\u0917 \u0906\u0909\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?',settings:{title:'\u0938\u0947\u091f\u093f\u0902\u0917',language:'\u092d\u093e\u0937\u093e \u091a\u0941\u0928\u0947',english:'\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u093c\u0940',hindi:'\u0939\u093f\u0902\u0926\u0940'},contacts:'\u0938\u0902\u092a\u0930\u094d\u0915',id:'\u0906\u0908 \u0921\u0940',name:'\u0928\u093e\u092e',designation:'\u092a\u0926 \u0915\u093e \u0928\u093e\u092e',sync:'\u0938\u093f\u0902\u0915 \u0915\u0930\u0947\u0902',search_by_name_and_number:'\u0928\u093e\u092e \u0914\u0930 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0916\u094b\u091c\u0947\u0902',contact_number:'\u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u0902\u0916\u094d\u092f\u093e',personal:'\u0928\u093f\u091c\u0940',official:'\u0911\u092b\u093f\u0938',close:'\u0915\u094d\u0932\u094b\u0938',holidays:'\u091b\u0941\u091f\u094d\u091f\u093f\u092f\u093e',apply:'\u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902',re_apply:'\u092a\u0941\u0928\u0903 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902 ',alert:'\u0905\u0932\u0930\u094d\u091f',status:'\u0938\u094d\u0925\u093f\u0924\u093f',created_on:'\u092a\u0930 \u092c\u0928\u093e\u092f\u093e',already_applied:'\u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0932\u093e\u0917\u0942 ... \u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 ',add_chamber_complaint:'\u091a\u0948\u0902\u092c\u0930 \u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u0924 \u091c\u094b\u0921\u093c\u0947\u0902',view_prev_chamber_complaint:'\u092a\u093f\u091b\u0932\u0940 \u091a\u0948\u0902\u092c\u0930 \u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u0924\u0947\u0902 \u0926\u0947\u0916\u0947\u0902',enter_distance_range:'\u0915\u0943\u092a\u092f\u093e \u0926\u0942\u0930\u0940 \u0938\u0940\u092e\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902',chamber_complaint_submitted:'\u091a\u0948\u0902\u092c\u0930 \u0915\u0940 \u0936\u093f\u0915\u093e\u092f\u09